{
	"name": "astro-generic-build-filenames",
	"version": "0.7.0",
	"description": "This package is designed to eliminate confusion caused by the default naming convention, which names files after their entry points.",
	"author": {
		"name": "Matthias Schöffmann",
		"url": "https://github.com/mschoeffmann"
	},
	"license": "MIT",
	"keywords": [
		"astro-integration",
		"astro-component",
		"withastro",
		"astro"
	],
	"homepage": "https://github.com/mschoeffmann/astro-generic-build-filenames",
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"type": "module",
	"peerDependencies": {
		"astro": "^5.0.0 || ^6.0.0 || ^7.0.0"
	},
	"devDependencies": {
		"astro": "^7.3.5",
		"publint": "^0.3.25",
		"tsdown": "^0.23.0",
		"typescript": "^6.0.3"
	}
}
