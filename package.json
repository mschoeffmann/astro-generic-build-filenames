{
	"name": "root",
	"private": true,
	"packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
	"engines": {
		"node": "^24"
	},
	"scripts": {
		"package:dev": "pnpm --filter astro-generic-build-filenames dev",
		"playground:dev": "pnpm --filter playground dev",
		"dev": "pnpm --stream -r --parallel dev",
		"build": "pnpm --filter astro-generic-build-filenames build",
		"test": "pnpm build && pnpm --filter playground test",
		"test:compat": "node scripts/test-compat.mjs",
		"changeset": "changeset",
		"release": "node scripts/release.mjs",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@changesets/cli": "^3.0.3"
	}
}
